{
  "name": "playspec",
  "version": "0.1.0",
  "description": "PlaySpec — LLM workflow engine",
  "type": "module",
  "bin": {
    "playspec": "dist/cli/index.js",
    "playspec-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "imports": {
    "#core/*.js": "./dist/core/*.js",
    "#storage/*.js": "./dist/storage/*.js",
    "#workflow/*.js": "./dist/workflow/*.js",
    "#template/*.js": "./dist/template/*.js",
    "#preset/*.js": "./dist/preset/*.js",
    "#utils/*.js": "./dist/utils/*.js",
    "#mcp/*.js": "./dist/mcp/*.js",
    "#migration/*.js": "./dist/migration/*.js",
    "#evolution/*.js": "./dist/evolution/*.js",
    "#viewer/*.js": "./dist/viewer/*.js",
    "#pack/*.js": "./dist/pack/*.js",
    "#eval/*.js": "./evals/workflow-prompts/*.ts"
  },
  "scripts": {
    "build": "tsc && tsc-alias && rm -rf dist/preset/assets && mkdir -p dist/preset/assets && cp -R src/preset/assets/. dist/preset/assets",
    "prepack": "pnpm build",
    "test:package-artifact": "vitest run tests/integration/package-artifact.test.ts",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "eval:workflow-prompts": "tsx scripts/eval-workflow-prompts.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "clipboardy": "^5.3.1",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.2",
    "handlebars": "^4.7.8",
    "marked": "^12.0.0",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "proper-lockfile": "^4.1.2",
    "simple-git": "^3.24.0",
    "yaml": "^2.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
