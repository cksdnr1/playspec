{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "#core/*.js": ["./src/core/*.js"],
      "#storage/*.js": ["./src/storage/*.js"],
      "#workflow/*.js": ["./src/workflow/*.js"],
      "#template/*.js": ["./src/template/*.js"],
      "#preset/*.js": ["./src/preset/*.js"],
      "#utils/*.js": ["./src/utils/*.js"],
      "#mcp/*.js": ["./src/mcp/*.js"],
      "#migration/*.js": ["./src/migration/*.js"],
      "#evolution/*.js": ["./src/evolution/*.js"],
      "#viewer/*.js": ["./src/viewer/*.js"],
      "#pack/*.js": ["./src/pack/*.js"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
